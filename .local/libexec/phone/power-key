#!/bin/sh
# Phone power key. niri would suspend on this key, which kills wifi, so it is
# bound here. Once bound, niri still lights the panel from the same press, so
# waking is mostly a fallback; blanking is the real job.
#
# Locking goes through the shell so the screen fades to black rather than being
# cut, which costs one ipc call (~270 ms here) plus the state query that picks
# the path. On an already locked session the shell ignores lockAndOutputsOff
# entirely, whatever the fade settings say, so that case blanks through the
# compositor instead -- ~55 ms, no fade available.
DPMS=/sys/class/drm/card1-DSI-1/dpms
STAMP="${XDG_RUNTIME_DIR:-/tmp}/dpms-on-since"

if [ "$(cat "$DPMS" 2>/dev/null)" = "Off" ]; then
    exec niri msg action power-on-monitors
fi

# The press that woke the screen reaches this bind too. touch-follow-dpms
# stamps when the panel lit up, and it polls, so give it a moment to notice.
sleep 0.25
if [ -r "$STAMP" ] && [ $(( $(date +%s) - $(cat "$STAMP") )) -le 2 ]; then
    exit 0
fi

if [ "$(dms ipc call lock isLocked 2>/dev/null)" = "true" ]; then
    exec niri msg action power-off-monitors
fi

exec dms ipc call lock lockAndOutputsOff
