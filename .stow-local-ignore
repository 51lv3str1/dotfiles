# Flat layout: this repo is one stow package, so anything here that is not
# meant for $HOME must be listed. Having this file at all replaces stow's
# built-in list, which is why the VCS entries are repeated below.
#
# Patterns are Perl regexes, anchored, matched per path segment.

\.git
\.gitignore
\.gitmodules
\.stow-local-ignore

README\.md

# The lockfile is gitignored but still lands on disk after `brew bundle`,
# and stow works off the filesystem, not off git.
Brewfile
Brewfile\.lock\.json

# Editor and OS noise
.+~
\#.*\#
\.DS_Store
