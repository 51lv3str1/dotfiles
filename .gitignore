# Per-machine settings: tokens, host-specific paths, work-only tweaks.
# Sourced last by env.sh / .zshrc if present. Never versioned.
local.sh
local.zsh
# stow folds ~/.config/alacritty into the repo, so a local.toml dropped in
# there lands here rather than outside it.
local.toml

# Homebrew lockfile from `brew bundle` -- machine-specific, regenerated.
Brewfile.lock.json

# yazi flavours: package.toml locks them, `ya pkg install` fetches them.
.config/yazi/flavors/

# Track CLAUDE.md only; the rest of ~/.claude is credentials and local state.
.claude/*
!.claude/CLAUDE.md

# Backups made while migrating files into this repo.
*.bak
*.bak-*
*.orig

# Editor / OS noise
*~
*.swp
.DS_Store

# DMS plugins: clones and per-machine plugin state. The bar configs that use
# them are versioned; the plugin trees are not.
.config/DankMaterialShell/plugins/
.config/DankMaterialShell/plugin_settings.json

# DMS mirrors the compositor's live output state here -- monitor names, modes,
# positions. Pure per-machine hardware, regenerated on every start.
.config/niri/dms/outputs.kdl
