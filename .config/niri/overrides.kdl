// Hand-written overrides, included last so they win over the dms files.
layout {
    focus-ring {
        width 3
        active-color   "#7355a6"
        inactive-color "#505050"
        urgent-color   "#9b0000"
    }
}

// From the phone. Mod+A is a second chord for the launcher dms already binds
// to Mod+Space; the browser one is new.
binds {
    Mod+B hotkey-overlay-title="Open Web Browser" { spawn "google-chrome"; }
    Mod+A hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+D hotkey-overlay-title="Open File Manager" {
        spawn "alacritty" "-e" "zsh" "-c" "source ~/.zshrc && yazi";
    }
}

// Only the phone has this output, so this block is inert everywhere else.
// DMS hardcodes its popout widths -- the control center asks for 550 logical
// px -- and niri's own scale of 2.25 leaves the panel 480 wide, so the popups
// ran off the screen. This is the versioned source for the phone's scale;
// dms/outputs.kdl only mirrors whatever niri ends up applying, which is why
// that file is git-ignored rather than tracked.
output "DSI-1" {
    scale 1.5
}
