// Custom niri overrides — NOT managed by DMS.
// Included last from config.kdl so these values win over the auto-generated
// dms/*.kdl files (niri includes are positional: last occurrence wins, merged
// field-by-field). Put your own tweaks here instead of editing dms/*.kdl.

layout {
    // Window gaps in logical pixels.
    // Ported from 51lv3str1/dotfiles niri layout.kdl (DMS default was 4).
    gaps 10

    // Everything below is ported from 51lv3str1/dotfiles niri layout.kdl.
    // NOTE: this overrides the matugen-generated dms/colors.kdl for these
    // elements, so they no longer follow the wallpaper — they stay a fixed
    // purple (Catppuccin mauve #cba6f7 / base #7355a6). The DankMaterialShell
    // top bar is intentionally untouched.

    // Border disabled: the focus-ring below is the only window outline.
    border {
        off
    }

    // "Neon" purple focus-ring: base purple #7355a6 -> lighter mauve #cba6f7,
    // interpolated in oklch. width 4 makes the active window clearly visible.
    focus-ring {
        width 4
        active-gradient from="#7355a6" to="#cba6f7" angle=45 in="oklch"
        inactive-color "#2a2a3a"
    }

    // Soft drop shadow on all windows (enabled with `on`; params were already
    // present but the shadow was off without it).
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    // Tab indicator (Mod+W tabbed columns): same purple gradient.
    tab-indicator {
        active-gradient from="#7355a6" to="#cba6f7" angle=45 in="oklch"
        inactive-color "#2a2a3a"
    }

    // Translucent purple guide shown when dragging a window to a drop spot.
    insert-hint {
        gradient from="#7355a680" to="#cba6f780" angle=45 in="oklch"
    }
}

// === Window rules (ported from 51lv3str1/dotfiles windowrules-custom.kdl) ===
// window-rule is a multipart section: niri applies matching rules in order and
// the last match wins. These live after the dms/* includes so they take
// precedence over the DMS-generated rules.

// Inactive windows are NOT dimmed (1.0) so they stay readable with many windows
// open. niri's opacity multiplies with the terminal's own (Alacritty is at 0.90),
// so lowering it made inactive windows illegible. Focus is shown by the purple
// ring + glow, not by transparency. (DMS defaults this to 0.90.)
window-rule {
    match is-active=false
    opacity 1.0
    // No shadow on inactive windows, so the purple glow on the active one is the
    // only shadow and clearly marks focus.
    shadow {
        off
    }
}

// Neon glow: purple shadow on the active window ONLY (offset 0,0 = symmetric halo
// all around). Inactive windows have no shadow (rule above), so the glow is the
// sole shadow and reinforces which window has focus.
window-rule {
    match is-active=true
    shadow {
        on
        softness 28
        spread 4
        offset x=0 y=0
        color "#7355a677"
    }
}

// AWS VPN Client requests floating on its own; force it to open tiled.
// app-id taken from `niri msg windows`. This rule lives after the dms/*
// includes so it wins. (Re-added: a prior revert removed it on the wrong
// assumption that the app would tile by default — it does not.)
window-rule {
    match app-id=r#"^AWS VPN Client$"#
    open-floating false
}
